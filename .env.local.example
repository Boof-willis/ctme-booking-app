# GoHighLevel (required)
GHL_API_KEY=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# GHL inbound-webhook triggers for the two intake workflows (required).
# The app posts the full survey payload to one of these after the contact upsert.
GHL_WEBHOOK_CALL_LEAD=
GHL_WEBHOOK_QUOTE_LEAD=

# Tracking (optional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Ads remarketing tag only. Conversion reporting itself is server-side via
# Ockno (GHL pipeline stage -> Ockno -> Google Ads), not fired from this app.
NEXT_PUBLIC_GOOGLE_ADS_ID=
